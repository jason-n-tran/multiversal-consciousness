# Simple Example Level - Tile-Based Coordinates
# Demonstrates the new tile-based coordinate system
# Each unit = 1 tile (32x32 pixels), origin at top-left (0,0)

[info]
name=Simple Example
description=A simple level demonstrating tile-based coordinates - much easier to design!

[agents]
# Format: type,number,x,y,speed (coordinates in tiles)
# Agent starts at tile position (5, 10) = pixel position (80, 336)
TestAgent,1,5,10,140

[quantum_nodes]
# Format: x,y,reality_a_item,reality_b_item,radius (coordinates in tiles, radius in pixels)
# Quantum node at tile position (8, 9) = pixel position (272, 304)
8,9,key,double_jump,40

[environment]
# Format: type,x,y,property1=value1,property2=value2 (coordinates in tiles, dimensions in tiles)
# Ground platform: 10 tiles wide, 1 tile high, starting at tile (1, 11)
wall,4,11,width=13,height=1,solid=true,type=ground
# Vertical wall: 1 tile wide, 3 tiles high, at tile (12, 8)
wall,12,9,width=1,height=2,solid=true
# Success zone: 2 tiles wide, 1 tile high, at tile (15, 10)
trigger,15,10,width=2,height=1,type=success_zone

[conditions]
# Format: type,target,value
agent_position,1,x>500
agent_has_ability,1,double_jump