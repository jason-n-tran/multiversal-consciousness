# Verification Scenario Test Level
# Demonstrates Phase 2 gameplay systems with high wall requiring DoubleJump
# Requirements: 6.1, 6.2, 6.3
# Coordinate system: Each unit = 1 tile (32x32 pixels), origin at top-left (0,0)

[info]
name=Verification Scenario
description=A test level demonstrating physics, abilities, and reality switching with a high wall obstacle requiring DoubleJump to traverse

[agents]
# Format: type,number,x,y,speed (coordinates in tiles)
TestAgent,1,3,14,140

[quantum_nodes]
# Format: x,y,reality_a_item,reality_b_item,radius (coordinates in tiles, radius in pixels)
5,13,none,double_jump,40

[environment]
# Format: type,x,y,property1=value1,property2=value2 (coordinates in tiles, dimensions in tiles)
# Left ground platform where agent starts (3 tiles wide, 1 tile high)
wall,3,15,width=4,height=1,solid=true,type=ground
# Small step platform for quantum node (2 tiles wide, 1 tile high)
wall,5,14,width=1,height=1,solid=true
# Tall wall obstacle (1 tile wide, 2 tiles high)
wall,6,12,width=1,height=2,solid=true
# Right platform after gap for success zone (4 tiles wide, 1 tile high)
wall,11,15,width=4,height=1,solid=true
# Left and right boundaries to prevent falling off (1 tile wide, 20 tiles high)
wall,2,10,width=1,height=20,solid=true
wall,15,10,width=1,height=20,solid=true
# Success detection area on right platform (4 tiles wide, 1 tile high)
trigger,13,14,width=2,height=1,type=success_zone

[conditions]
# Format: type,target,value
# Verification conditions
agent_position,1,x>450
agent_has_ability,1,double_jump
reality_state,current,B